{
  "name": "trusted-ai-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Cambodia Trusted AI Document Platform — Phase 1 Scaffold",
  "workspaces": [
    "apps/backend",
    "apps/frontend",
    "packages/shared-types"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml,scss,css}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,yml,yaml,scss,css}\"",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "ci": "CI=true npm run ci:checks",
    "ci:checks": "npm run audit:production && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.0.0"
  }
}
