// Phase 1 — datasource and generator configuration only.
//
// No application model is defined in Phase 1. Prisma 7 allows generating a
// client without models by default. The $queryRaw raw-query method (SELECT 1)
// is used for connectivity testing.
//
// Business models are introduced in later phases when application schema
// design begins under explicit human approval.

datasource db {
  provider = "postgresql"
  // No `url` field: the @prisma/adapter-pg driver adapter reads DATABASE_URL
  // directly in application code (DatabaseHealthService, PrismaService).
  // `prisma generate` and `prisma migrate` both work without a datasource url
  // when using the driver-adapter pattern. Adding a url here is not required
  // and would be misleading.
}

generator client {
  provider = "prisma-client-js"
}
