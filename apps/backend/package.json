{
  "name": "@trusted-ai/backend",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS backend health service",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "pretypecheck": "npm run prisma:generate",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run prisma:generate",
    "test": "jest --passWithNoTests",
    "pretest:ci": "npm run prisma:generate",
    "test:ci": "jest --ci --coverage --passWithNoTests",
    "prisma:generate": "prisma generate",
    "prebuild": "npm run prisma:generate",
    "db:check": "ts-node src/db-check.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@trusted-ai/shared-types": "*",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.28",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.1.2",
    "@types/pg": "8.20.3",
    "jest": "30.4.2",
    "prisma": "7.9.1",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
