{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "declaration": false,
    "declarationMap": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "rootDir": "./src",
    "outDir": "./dist",
    "types": ["jest", "node"]
  },
  "include": ["src/**/*.ts"]
}
