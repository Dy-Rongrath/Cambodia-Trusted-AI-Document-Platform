# trusted-ai-platform — .gitattributes
# Ensures consistent line endings across macOS, Linux, and Windows contributors.

# Default: normalise all text files to LF on checkout
* text=auto eol=lf

# Shell scripts — always LF
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
Makefile text eol=lf

# Windows batch files — always CRLF (if ever used)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Source code — text, LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.py text eol=lf
*.pyi text eol=lf
*.dart text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.graphql text eol=lf
*.gql text eol=lf
*.prisma text eol=lf
*.sql text eol=lf
*.env.example text eol=lf
*.md text eol=lf
*.mdx text eol=lf
*.txt text eol=lf
*.csv text eol=lf

# Docker
Dockerfile* text eol=lf
*.dockerignore text eol=lf
docker-compose*.yml text eol=lf

# Config files
.gitignore text eol=lf
.gitattributes text eol=lf
.nvmrc text eol=lf
.python-version text eol=lf
.editorconfig text eol=lf
*.conf text eol=lf
*.ini text eol=lf
*.cfg text eol=lf

# Binary files — do not perform line-ending conversion
