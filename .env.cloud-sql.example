# Optional Cloud SQL development profile. Copy to `.env.cloud-sql`; never commit it.
# Keep the instance connection name and credentials environment-specific.
CLOUD_SQL_INSTANCE_CONNECTION_NAME=your-gcp-project:asia-southeast1:your-postgres-18-instance
CLOUD_SQL_CREDENTIALS_FILE=/absolute/path/to/application_default_credentials.json

# URL-encode the username and password. TLS is required by project policy.
# The hostname must remain `cloud-sql-proxy` for the Docker Compose profile.
CLOUD_SQL_DATABASE_URL=postgresql://app_user:url_encoded_password@cloud-sql-proxy:5432/trusted_ai_db?schema=public&sslmode=disable

BACKEND_PORT=3000
FRONTEND_PORT=4200
